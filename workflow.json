{
  "name": "Local AI Email Auto-Responder",
  "nodes": [
    {
      "parameters": {
        "postProcessAction": "read",
        "format": "resolved",
        "options": {
          "customEmailConfig": "[\"UNSEEN\"]"
        }
      },
      "name": "EmailReadImap",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "credentials": {
        "imap": {
          "id": "1",
          "name": "IMAP account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.subject }}",
              "operation": "notContains",
              "value2": "Re: AI Auto-Reply:"
            }
          ]
        }
      },
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama3:8b', prompt: 'You are an intelligent auto-responder acting on behalf of the recipient. You are replying to an incoming email from ' + $json.from.value[0].address + '. Read their email carefully and write a polite, professional, and contextually accurate response. Do NOT assume you own the things they are talking about unless it makes sense. Keep it brief.\\n\\nIncoming Email Subject: ' + $json.subject + '\\nIncoming Email Body: ' + $json.text + '\\n\\nWrite only the body of the reply email. Do not include subject lines or headers.', stream: false }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        650,
        280
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env[\"SMTP_USER\"] }}",
        "toEmail": "={{ $node[\"EmailReadImap\"].json.from.value[0].address }}",
        "subject": "={{ 'Re: AI Auto-Reply: ' + $node[\"EmailReadImap\"].json.subject }}",
        "text": "={{ $node[\"HTTP Request\"].json.response }}",
        "options": {
          "messageId": "={{ $node[\"EmailReadImap\"].json.messageId }}"
        }
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        850,
        280
      ],
      "credentials": {
        "smtp": {
          "id": "2",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "EmailReadImap": {
      "main": [
        [
          {
            "node": "IF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
